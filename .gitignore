# Repo-wide ignores. tools/tiling-video keeps a .gitignore beside it for its
# own working files: frames, probes, music stems and node_modules.

# Operating system files
.DS_Store
._*
Thumbs.db
desktop.ini

# Editor and agent settings
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

# Local Jekyll preview
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Node and Python working files
node_modules/
__pycache__/
*.pyc
.venv/

# Logs and scratch output
*.log
*.tmp

# Local config and secrets. Commit the matching *.example.json template.
.env
.env.*
*.local.json

# Renders: what a script writes for a person to review, such as stills,
# contact sheets, mock-up screenshots and videos. Each tool writes these into
# a renders/ folder beside it, and its tracked script rebuilds them. A file
# the site loads stays outside renders/ and stays tracked.
renders/

# Audio and video. The site plays no media file, so none belongs in git.
*.mp4
*.m4v
*.mov
*.webm
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.flac
*.aif
*.aiff
